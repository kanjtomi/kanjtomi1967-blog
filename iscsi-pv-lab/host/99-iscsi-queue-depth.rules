# Raise the queue depth of the Zadara iSCSI LUN (iscsi-pv-lab) from the
# open-iscsi default of 32 to 64, matching the target's default_cmdsn_depth.
# At 32 the LUN capped at ~23k 4k IOPS (32 / ~1.3 ms per round trip); at 64
# it reaches ~34k IOPS (4k randrw 70/30) and the 1 GbE link becomes the limit.
# Install on the RHEL host: /etc/udev/rules.d/99-iscsi-queue-depth.rules
# Applies whenever the LUN appears (iSCSI login by kubelet, reboot).
ACTION=="add|change", SUBSYSTEM=="scsi", ENV{DEVTYPE}=="scsi_device", ATTR{vendor}=="LIO-ORG*", ATTR{model}=="k8s-iscsi-pv1*", ATTR{queue_depth}="64"
